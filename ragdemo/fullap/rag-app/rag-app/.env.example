# RAG Application Environment Variables
# These are the default values used in docker-compose.yml
# You typically don't need to change these unless you have specific requirements

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Application Settings
PYTHONUNBUFFERED=1

# Flask Configuration (Web App)
FLASK_ENV=development

# Note: These variables are set in docker-compose.yml
# Copy this file to .env if you need to override any values
